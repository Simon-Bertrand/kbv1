COMPOSE_FILE=compose.dev.yaml

# Chemins relatifs à la racine du projet. Les répertoires montés doivent exister.
DATA_DIR=./data
SOURCE_VERSIONS_DIR=./source-versions
# Inclut embeddings/multilingual_e5_large et les poids PdfParse.
MODELS_DIR=/mnt/e/models

# Ports publiés sur la boucle locale.
POSTGRES_PORT=5432
FILESERVER_PORT=18080
PDFPARSE_PORT=8000
ENCODER_PORT=8001
INDEXER_PORT=8011
WEBUI_PORT=3000
KM_FRONTEND_PORT=8088

# Valeurs d'exemple pour une stack de développement locale.
POSTGRES_DB=knowledgebase
POSTGRES_PASSWORD=dev-postgres-password
POSTGRES_AGENT_PASSWORD=dev-agent-password
POSTGRES_KM_READER_PASSWORD=dev-km-reader-password
POSTGRES_KM_WRITER_PASSWORD=dev-km-writer-password
POSTGRES_WEBUI_PASSWORD=dev-webui-db-password-local-only

FILESERVER_DEV_USER=dev
FILESERVER_DEV_PASSWORD=dev
FILESERVER_JWT_SECRET=dev-fileserver-jwt-secret-local-only
FILESERVER_UI_SECRET=dev-fileserver-ui-secret-local-only
FILESERVER_LOG_PROXY_IPS=

PDFPARSE_ADMIN_USER=studio
PDFPARSE_ADMIN_PASSWORD=dev-studio-password

# Authentification locale WebUI et recherche documentaire.
WEBUI_AUTH_SECRET=dev-webui-auth-secret-local-only-1234
WEBUI_AUTH_ADMIN_LOGIN=admin
WEBUI_AUTH_ADMIN_PASSWORD=dev-webui-admin-password-local-only
WEBUI_AUTH_TRUST_HOST=true
WEBUI_TRUST_PROXY=false
WEBUI_SEARCH_MODE=hybrid
WEBUI_SESSION_EPOCH=0
WEBUI_DISABLED_SUBJECTS=
WEBUI_LOGIN_IP_RPS=0.2
WEBUI_LOGIN_IP_BURST=5
WEBUI_LOGIN_ACCOUNT_RPS=0.1
WEBUI_LOGIN_ACCOUNT_BURST=10
WEBUI_CHAT_SECONDS=180
WEBUI_CHAT_RATE_LIMIT_RPS=1
WEBUI_CHAT_RATE_LIMIT_BURST=2
WEBUI_SEARCH_RATE_LIMIT_RPS=1
WEBUI_SEARCH_RATE_LIMIT_BURST=3
KM_API_TOKEN=

# Intégration Agent Athena et Reranker pour WebUI
WEBUI_AGENT_URL=http://km-agent:8086
KM_AGENT_SERVICE_TOKEN=
WEBUI_RERANKER_URL=http://reranker:8002

# Renseigner ensemble pour activer OIDC.
WEBUI_AUTH_OIDC_ISSUER=
WEBUI_AUTH_OIDC_ID=
WEBUI_AUTH_OIDC_SECRET=
