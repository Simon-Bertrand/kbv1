# Generate a unique value, e.g. openssl rand -base64 48.
WEBUI_AUTH_SECRET=
WEBUI_AUTH_URL=http://localhost:4173
# true only when Host / X-Forwarded-* are controlled by your deployment.
WEBUI_AUTH_TRUST_HOST=true

# Server-only administrator credentials. No default account; both are required
# for password login. Leave empty to refuse local logins (OIDC remains optional).
WEBUI_AUTH_ADMIN_LOGIN=
WEBUI_AUTH_ADMIN_PASSWORD=

# Server-only origins, accessible from the Next.js process/container.
# These Docker names require webui and KM to share a Docker network.
WEBUI_AGENT_URL=http://km-agent:8086
WEBUI_KM_API_URL=http://km-api:8000
WEBUI_RERANKER_URL=http://reranker:8002
WEBUI_CHAT_SECONDS=180
WEBUI_SEARCH_MODE=hybrid

# Optional OIDC; configure all three together.
WEBUI_AUTH_OIDC_ISSUER=
WEBUI_AUTH_OIDC_ID=
WEBUI_AUTH_OIDC_SECRET=
