{
  "name": "pdfparse-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "python -m pdfparse.backend --export-openapi openapi.json && openapi-ts",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run generate && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.3.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
